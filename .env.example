# Obrigatório em produção (Easypanel): URL pública do backend, sem barra final.
# Auth API (cookie) — nunca o host Bearer api-public.
NEXT_PUBLIC_API_BASE_URL=https://api.seudominio.com

# Browser → auth API direto quando página e API compartilham o tenant
# (cookie Domain=`.base`). Desligar: NEXT_PUBLIC_DIRECT_BROWSER_API=0
# NEXT_PUBLIC_DIRECT_BROWSER_API=1

# Obrigatório: URL pública deste frontend (cookies / redirects NextAuth).
# Em prod com wildcard: apex https://crm.eduit.com.br (tenants = {slug}.crm.eduit.com.br).
NEXTAUTH_URL=https://crm.eduit.com.br

# Multi-tenant por subdomínio (Kommo-style).
# NEXT_PUBLIC_TENANT_BASE_DOMAIN=crm.eduit.com.br
# NEXT_PUBLIC_TENANT_PROTOCOL=https
# Dev sem DNS wildcard: use {slug}.localhost:3000 ou header x-tenant-slug.

# Obrigatório: mesmo valor do backend (JWT da sessão).
NEXTAUTH_SECRET=

# Opcional: Auth.js v5 — se definido, deve ser igual a NEXTAUTH_SECRET.
# AUTH_SECRET=

# Opcional: STUN/TURN para ligação WhatsApp WebRTC (JSON no browser).
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=

# Opcional: URL do serviço nginx do Cockpit IA (agente_ia_acad). Se ausente,
# /ai-agents renderiza só a tela de Agentes — igual ao comportamento atual.
# NEXT_PUBLIC_COCKPIT_URL=https://banco-agente-ia-acad.6tqx2r.easypanel.host

# Apenas para sandbox do v0.dev: bypass de autenticação no middleware
# (cookies cross-origin do v0 são bloqueados pelo browser, então login
# real nunca persiste). Adiciona um botão "Entrar (preview)" na tela de
# login que pula direto pra rota destino. NUNCA ative em produção.
# NEXT_PUBLIC_PREVIEW_MODE=true
#
# Dupla chave (SEC-13/SEC-21): em build de produção (NODE_ENV=production)
# NEXT_PUBLIC_PREVIEW_MODE sozinho é IGNORADO — o middleware não libera rotas,
# /api/preview-login responde 404 e o fallback por Host *.v0.dev fica
# desligado. Um sandbox que rode `next build && next start` precisa também de:
# NEXT_PUBLIC_PREVIEW_MODE_ALLOW_PRODUCTION_BUILD=true
#
# Mocks fora do bundle: o catálogo de respostas fake do preview
# (src/lib/preview-mocks.ts) e as telas /showcase, /ds-showcase e /dev só
# entram no build quando o preview está habilitado pela regra acima (ou fora
# de produção). O next.config.ts deriva disso NEXT_PUBLIC_PREVIEW_MOCKS_BUNDLED
# — NÃO defina essa variável à mão. Depois de um build de produção normal,
# `node scripts/check-bundle-sem-mocks.mjs` confirma que nenhum mock ficou em
# .next/static.

# SSE única por navegador (líder entre abas — Web Locks + BroadcastChannel):
# só uma aba abre o EventSource e manda o heartbeat de presença; as outras
# recebem pelo canal. Ligado por padrão. `0` volta ao comportamento anterior
# (uma conexão SSE e um heartbeat por aba). Override por navegador, sem
# rebuild: localStorage["bwipo:sse-single-leader"] = "0" | "1" (recarregar
# todas as abas).
# NEXT_PUBLIC_SSE_SINGLE_LEADER=1

# App mobile (APK): manifesto e base pública dos downloads.
# O manifesto vem do serviço de releases (default: host do EasyPanel fixo em
# src/lib/native/mobile-release-config.ts). Para não expor esse host interno
# em /api/mobile-release e no app, publique os APKs num domínio próprio e
# aponte as variáveis abaixo para ele. Sem elas, nada muda (default atual).
#   - manifesto (build): URL completa do mobile-release.json
# NEXT_PUBLIC_MOBILE_RELEASE_MANIFEST_URL=
#   - base pública do APK: troca a origem do `apkUrl` do manifesto, mantendo o
#     caminho (/releases/arquivo.apk). A de servidor vale em runtime no proxy
#     /api/mobile-release; a NEXT_PUBLIC (build) vale também dentro do app.
# MOBILE_RELEASE_PUBLIC_BASE_URL=
# NEXT_PUBLIC_MOBILE_RELEASE_PUBLIC_BASE_URL=
