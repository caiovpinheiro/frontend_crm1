# syntax=docker/dockerfile:1
#
# Dockerfile para deploy pre-buildado via GitHub Actions.
#
# O `next build` e executado no proprio workflow GHA (com actions/cache
# para node_modules e .next/cache). Este Dockerfile apenas empacota o
# output standalone + static gerado la.
#
# Resultado: Docker build ~10s vs ~2-3min com build inline no Dockerfile
# original, porque nao ha npm install nem compilacao aqui.
#
# Uso: requer que .next/standalone e .next/static existam no contexto
# (o workflow GHA garante isso apos `npm run build`).
#
# Imagem base vem do espelho no GHCR deste repositório (alimentado por
# .github/workflows/mirror-base-image.yml), não do ECR Public: a cota anônima
# do public.ecr.aws é por IP e os runners do GitHub a compartilham — em
# 17/10/2026 builds da main caíram com "toomanyrequests: Data limit exceeded".
# O build-and-deploy.yml já faz login no GHCR antes do build.
# Build local sem login no GHCR: --build-arg BASE_IMAGE=node:22-bookworm-slim
ARG BASE_IMAGE=ghcr.io/caiovpinheiro/frontend_crm1/node:22-bookworm-slim

FROM ${BASE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update -y && apt-get install -y --no-install-recommends \
      openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --chown=nextjs:nodejs public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
